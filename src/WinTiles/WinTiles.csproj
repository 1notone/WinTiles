<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>          <!-- NotifyIcon (system tray) and Screen -->
    <RootNamespace>WinTiles</RootNamespace>
    <AssemblyName>WinTiles</AssemblyName>
    <ApplicationIcon>Assets\WinTiles.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WinTiles.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Both WPF and WinForms are referenced; keep WPF's types the default for common names. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Publishing for a specific CPU (see build.ps1): one self-contained .exe, so nothing else needs installing. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon; don't let its global usings shadow WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- System.IO.Path would clash with WPF's Shapes.Path; files that need System.IO import it themselves. -->
    <Using Remove="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinTiles.Core\WinTiles.Core.csproj" />
    <Resource Include="Assets\WinTiles.ico" />
  </ItemGroup>
</Project>
