<Project>
  <PropertyGroup>
    <Version>1.2.0</Version>
    <Authors>WinTiles contributors</Authors>
    <Copyright>© 2026 WinTiles contributors. MIT License.</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the Windows projects build on macOS/Linux too (useful for CI and quick checks). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
